    "The host disconnected this network adapter. Check the selected interface, VPN, and network access, then reconnect." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机断开了此网络适配器。请检查所选网络接口、VPN 和网络访问，然后重新连接。"
          }
        }
      }
    },
    "The image will be saved and reused for future virtual machines." : {

    },
    "The password stays in this Mac’s Keychain until you confirm that macOS setup completed. It is never stored in the virtual machine bundle." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您确认 macOS 设置完成前，密码会保留在此 Mac 的钥匙串中，绝不会存入虚拟机包。"
          }
        }
      }
    },
    "The previous provisioning attempt was interrupted. Sign in as “%@” if the account exists; otherwise choose Retry Next Start. EZVM will not submit it again automatically." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次预配置操作已中断。如果账户存在，请尝试以“%@”登录；否则请选择“下次启动时重试”。EZVM 不会自动再次提交。"
          }
        }
      }
    },
    "The running virtual machine no longer has an available USB controller. Restart the virtual machine and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的虚拟机不再有可用的 USB 控制器。请重新启动虚拟机后重试。"
          }
        }
      }
    },
    "The signed-release list updates automatically via IPSW.me. Downloads come directly from Apple; EZVM performs the final host compatibility check before installation." : {

    },
    "The snapshot transaction is finishing and can no longer be cancelled" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快照事务正在安全完成，现已无法取消"
          }
        }
      }
    },
    "The temporary provisioning credential is no longer available." : {
