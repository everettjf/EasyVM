          }
        }
      }
    },
    "This build does not include the Accessory Access entitlement required for USB passthrough." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此构建未包含 USB 直通所需的配件访问权限。"
